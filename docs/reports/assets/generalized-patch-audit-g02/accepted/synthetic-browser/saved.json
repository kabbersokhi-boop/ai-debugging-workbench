        "adapter_sources": {
          "probe.py": "\"\"\"Fixed JSON observation adapter. Executed only inside an approved disposable container.\"\"\"\n\nimport contextlib\nimport importlib.util\nimport json\nimport sys\nfrom typing import Any\n\n\ndef main():\n    with open(\"/verifier/inputs.json\") as stream:\n        inputs = json.load(stream)\n    sys.path[:0] = [\"/work/deps\", \"/source\"]\n    observations = []\n    for call in inputs[\"calls\"]:\n        try:\n            with contextlib.redirect_stdout(sys.stderr):\n                spec = importlib.util.spec_from_file_location(\n                    \"_independent_target\", inputs[\"module\"]\n                )\n                if spec is None or spec.loader is None:\n                    raise ValueError(\"Unsupported Python import\")\n                module = importlib.util.module_from_spec(spec)\n                spec.loader.exec_module(module)\n                function: Any = module\n                for name in inputs[\"export\"].split(\".\"):\n                    function = getattr(function, name)\n                value = function(*call[\"args\"], **call[\"kwargs\"])\n                # Reject non-JSON values instead of stringifying them into apparent observations.\n                value = json.loads(json.dumps(value, allow_nan=False))\n            observations.append({\"id\": call[\"id\"], \"kind\": \"value\", \"value\": value})\n        except Exception as error:\n            observations.append(\n                {\"id\": call[\"id\"], \"kind\": \"execution_error\", \"error\": type(error).__name__}\n            )\n    print(json.dumps({\"version\": \"observations-v1\", \"observations\": observations}, allow_nan=False))\n\n\nif __name__ == \"__main__\":\n    main()\n",
          "probe.cjs": "// Fixed adapter; expected values and scoring never enter the candidate environment.\nconst fs = require('node:fs');\nconst {pathToFileURL} = require('node:url');\nconst emit = process.stdout.write.bind(process.stdout);\nconsole.log = (...args) => console.error(...args);\nasync function main() {\n  const inputs = JSON.parse(fs.readFileSync('/verifier/inputs.json', 'utf8'));\n  const observations = [];\n  for (const call of inputs.calls) {\n    try {\n      let fn = inputs.module.endsWith('.mjs')\n        ? await import(pathToFileURL(inputs.module).href)\n        : require(inputs.module);\n      for (const name of inputs.export ? inputs.export.split('.') : []) fn = fn[name];\n      const value = await fn(...call.args);\n      // JSON.stringify silently rewrites undefined/NaN; reject that unsupported domain.\n      function valid(v) {\n        if (v === null || typeof v === 'string' || typeof v === 'boolean') return;\n        if (typeof v === 'number' && Number.isFinite(v)) return;\n        if (Array.isArray(v)) return v.forEach(valid);\n        if (typeof v === 'object' && Object.getPrototypeOf(v) === Object.prototype)\n          return Object.values(v).forEach(valid);\n        throw Error('Unsupported JSON observation');\n      }\n      valid(value);\n      observations.push({id: call.id, kind: 'value', value});\n    } catch (error) {\n      observations.push({id: call.id, kind: 'execution_error', error: String(error.name)});\n    }\n  }\n  emit(JSON.stringify({version: 'observations-v1', observations}) + '\\n');\n}\nmain().catch(() => process.exitCode = 2);\n"
        },
